DRIVER=~fastapi+~httpx+~websockets+~aiohttp
SUPERUSERS=["12345678"]
COMMAND_START=["/"]

# OneBot V11（反向 WS：NoneBot 主动连接协议端）
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
ONEBOT_ACCESS_TOKEN=your_onebot_token

# Telegram（可与 OneBot 同时启用）
telegram_bots=[{"token": "123456:ABC-DEF"}]
# TELEGRAM_PROXY=http://127.0.0.1:7890

# CPA 插件
CPA_BASE_URL=http://127.0.0.1:8317
CPA_MANAGEMENT_KEY=plaintext-management-password
# CPA_ADMINS=["87654321"]
# CODEX_REFRESH_ADMIN=["87654321"]
# CPA_TIMEOUT=15
# CPA_OAUTH_POLL_INTERVAL=3
# CPA_OAUTH_TIMEOUT=1800
# CPA_QUOTA_TIMEOUT=25
# CPA_QUOTA_CONCURRENCY=4
# CPA_QUOTA_CACHE_TTL=60
# CPA_QUOTA_IMAGE=true
# CPA_QUOTA_IMAGE_WIDTH=520
# CPA_ALIAS_FILE=data/cpa_aliases.json
# CPA_ALIASES={"user@example.com":"AG-1"}
#
# 注：额度图主题（shadcn/mac/md3）与每行卡片数（1..6）直接存储在别名同级目录下的 cpa_render_settings.json 中，
# 默认 theme=shadcn、cards_per_row=4，无需环境变量配置，使用 /cpa theme set 与 /cpa card row 即时修改并持久化。
#
# 独立 FastAPI 服务器（不与 NoneBot 共用端口）。默认关闭。
# SERVER_MODE=false
# CLIENT_NAME=Server
# CPA_SERVER_HOST=127.0.0.1
# CPA_SERVER_PORT=8320
# CPA_SERVER_CLIENT_KEYS={"Home":"replace-with-random-secret"}
# CPA_SERVER_REQUEST_TIMEOUT=40
# CPA_SERVER_WS_MAX_SIZE=1048576
# CPA_SERVER_MAX_ACCOUNTS=200
